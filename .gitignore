__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store

# Generated data. Committed: inventory, manifests, page text, PDFs, app text, aligned tables
# and the training corpus (corpus/, which holds the audio). Kept local only: video, images,
# APKs, fonts/styles, and app audio (exported into corpus/speech/<lang>/audio/).
data/raw/*
!data/raw/metadata/
!data/raw/pages/
!data/raw/assets/
data/raw/assets/**
!data/raw/assets/**/
!data/raw/assets/**/*.pdf
data/apps/**
!data/apps/**/
!data/apps/*.csv
!data/apps/*.json
!data/apps/*.jsonl
!data/apps/**/*.html
!data/apps/**/*.htm
!data/apps/**/*.js
!data/apps/**/*.json
!data/apps/**/*.xml
!data/apps/**/*.txt
!data/apps/**/*.vtt
!data/apps/**/*.srt
# Intermediate alignment tables: regenerated by the pipeline and fully exported to corpus/;
# several exceed GitHub's file-size limits. Only the summary is committed.
data/aligned/*
!data/aligned/summary.json
# Webonary: saved pages are committed; the pronunciation audio is exported into corpus/.
data/webonary/*/audio/
*.log
